rules_version = '2';

// Machine Shop Control Board — Firestore security rules
// - Only signed-in, active users can read anything.
// - Users are graded G1-G8 (lower number = higher position). G1-G5 are admins, G6-G8 are regular users.
// - Regular users: closing checks, stock counts / receive / issue, report tool missing / damaged / found.
// - Admins: everything, including tool and stock setup, history edits and user management.
// - The very first admin is created once from the setup screen (config/bootstrap).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function userDoc() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function profile() { return get(userDoc()).data; }
    function active() { return signedIn() && exists(userDoc()) && profile().active == true; }
    function isAdmin() { return active() && profile().role == 'admin'; }
    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }
    function bootstrapPath() { return /databases/$(database)/documents/config/bootstrap; }
    // role must match grade: G1-G5 -> admin, G6-G8 -> tech
    function gradeMatchesRole(d) {
      return d.grade in ['G1', 'G2', 'G3', 'G4', 'G5', 'G6', 'G7', 'G8']
        && ((d.grade in ['G1', 'G2', 'G3', 'G4', 'G5']) == (d.role == 'admin'))
        && d.role in ['admin', 'tech'];
    }

    // One-time setup marker. Anyone may check whether setup has been done.
    match /config/bootstrap {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && !exists(bootstrapPath())
        && getAfter(userDoc()).data.role == 'admin';
      allow update, delete: if false;
    }

    match /config/{docId} {
      allow read: if active();
      allow write: if isAdmin() && docId != 'bootstrap';
    }

    match /users/{uid} {
      allow get: if active() && (request.auth.uid == uid || isAdmin());
      // Lets a signed-in user see their own profile even when inactive, so the app can say so.
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if isAdmin();
      allow create: if gradeMatchesRole(request.resource.data) && (isAdmin()
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.role == 'admin'
            && request.resource.data.active == true
            && !exists(bootstrapPath())
            && existsAfter(bootstrapPath())));
      // Admins cannot demote or deactivate themselves (prevents locking everyone out):
      // on their own record they may change name, position and grade, but must stay G1-G5 / admin.
      allow update: if isAdmin()
        && (!('grade' in request.resource.data) || gradeMatchesRole(request.resource.data))
        && (request.auth.uid != uid
            || (onlyChanges(['name', 'position', 'grade']) && request.resource.data.role == 'admin'));
      allow delete: if isAdmin() && request.auth.uid != uid;
    }

    match /items/{id} {
      allow read: if active();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (active() && onlyChanges(['status', 'missingSince', 'damagedSince']));
    }

    match /stock/{id} {
      allow read: if active();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (active() && onlyChanges(['onHand', 'lastCountAt']));
    }

    match /moves/{id} {
      allow read, create: if active();
      allow update, delete: if isAdmin();
    }

    match /checks/{id} {
      allow read, create: if active();
      allow update: if isAdmin()
        || (active() && !('editedAt' in request.resource.data));
      allow delete: if isAdmin();
    }
  }
}
